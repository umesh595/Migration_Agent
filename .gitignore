# Secrets — never commit. Use the .env*.example templates instead.
.env
.env.*
!.env.example
!.env.local.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.coverage
htmlcov/
.ruff_cache/

# Node / Next.js
node_modules/
.next/
next-env.d.ts
*.tsbuildinfo

# Local (non-Docker) dev services — native Postgres data dir/logs from running
# outside docker-compose. Binary DB pages, never meant to be versioned.
.local_pgdata/
.local_logs/
.local_pglog*
# scripts/dev.ps1 -Mode local: PID files + logs for the processes it starts.
.local_run/

# Exports / scratch
*.docx
!docs/**/*.docx
opencode.json
